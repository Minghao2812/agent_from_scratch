# Python
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/

# 虚拟环境
.venv/
venv/
env/

# 密钥与本地配置（只提交 .env.example；旧 setup_env.sh 继续忽略，防止误提交）
.env
.env.*
!.env.example
setup_env.sh
api.md
personal_api.md
**/secrets.md


# 编辑器与本地工具（settings.json 含本机 conda 绝对路径）
.vscode/
.idea/
.specstory/
.cursorindexingignore

# 系统文件
.DS_Store

# 开发过程记录，不进入提交
PROGRESS.md

# agent 运行产物：每次运行都会在 output/<agent>/<时间戳>/ 下生成一份，纯粹是
# regenerable 的调试/验收中间产物（含大量截图），不需要进版本库
workspace/output/*/
!workspace/output/.gitkeep
