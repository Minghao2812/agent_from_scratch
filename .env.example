# 复制为 .env 后填写。程序和冒烟测试都会自动加载；不要提交 .env。
#   cp .env.example .env

# ---------- 冒烟测试凭证 ----------
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_FLASH_MODEL=deepseek-v4-flash
DEEPSEEK_PRO_MODEL=deepseek-v4-pro

QWEN_API_KEY=sk-your-qwen-key
QWEN_BASE_URL=https://llm-m2yjgjcagknobxxe.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
QWEN_RERANK_URL=https://llm-m2yjgjcagknobxxe.cn-beijing.maas.aliyuncs.com/compatible-api/v1/reranks
QWEN_CHAT_MODEL=qwen3.7-max
QWEN_VL_MODEL=qwen3-vl-plus
QWEN_EMBEDDING_MODEL=text-embedding-v4
QWEN_RERANK_MODEL=qwen3-rerank

ZHIPU_API_KEY=your-zhipu-key
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
ZHIPU_MODEL=glm-5.2

BOCHA_API_KEY=sk-your-bocha-key
BOCHA_BASE_URL=https://api.bochaai.com

# ---------- Agent 模型 ----------
# litellm 使用 provider/model 格式。
# DeepSeek（默认）
MODEL=deepseek/deepseek-v4-flash

